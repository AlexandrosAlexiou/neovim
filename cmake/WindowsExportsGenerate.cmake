file(MAKE_DIRECTORY "${OUTPUT}.objects")
file(WRITE "${OUTPUT}.objs" "")
foreach(archive IN LISTS ARCHIVES)
  execute_process(COMMAND "${ARCHIVER}" /nologo /list "${archive}"
    OUTPUT_VARIABLE members RESULT_VARIABLE result)
  if(NOT result EQUAL 0 OR members STREQUAL "")
    message(FATAL_ERROR "Cannot list ${archive}")
  endif()
  string(REPLACE "\n" ";" members "${members}")
  foreach(member IN LISTS members)
    string(STRIP "${member}" member)
    get_filename_component(extension "${member}" EXT)
    string(TOLOWER "${extension}" extension)
    if(member STREQUAL "" OR extension STREQUAL ".dll" OR extension STREQUAL ".exe")
      continue()
    endif()
    string(MD5 id "${archive}/${member}")
    set(object "${OUTPUT}.objects/${id}.obj")
    execute_process(COMMAND "${ARCHIVER}" /nologo "${archive}"
      "/extract:${member}" "/out:${object}" RESULT_VARIABLE result)
    if(NOT result EQUAL 0)
      message(FATAL_ERROR "Cannot extract ${member} from ${archive}")
    endif()
    file(APPEND "${OUTPUT}.objs" "${object}\n")
  endforeach()
endforeach()
execute_process(COMMAND "${CMAKE_COMMAND}" -E __create_def "${OUTPUT}" "${OUTPUT}.objs"
  RESULT_VARIABLE result)
if(NOT result EQUAL 0)
  file(REMOVE "${OUTPUT}")
  message(FATAL_ERROR "Cannot generate dependency exports; objects must be built without /GL")
endif()
